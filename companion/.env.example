PLAYBACK_TOKEN=replace-with-a-long-random-private-key
ALLOWED_ORIGINS=https://tiktaktv.me,https://www.tiktaktv.me,https://zachgus33.github.io
# Put named-tunnel settings in the private .env.tunnel file instead.
# TUNNEL_TOKEN=your-cloudflare-tunnel-token
# PUBLIC_PLAYBACK_URL=https://api.tiktaktv.me
# Optional YouTube Data API search key.
# YOUTUBE_API_KEY=
# Google OAuth client type: "TVs and Limited Input devices". These enable the
# device-code sign-in used by browsers, Fire TV and Android TV.
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# A base64-encoded 32-byte key. FRIEND_VAULT_KEY is used as a fallback.
# YOUTUBE_VAULT_KEY=
