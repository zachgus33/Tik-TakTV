<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/tiktak_tv_banner"
        android:enableOnBackInvokedCallback="false"
        android:icon="@drawable/tiktak_tv_icon"
        android:logo="@drawable/tiktak_tv_icon"
        android:roundIcon="@drawable/tiktak_tv_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nuvio"
        android:usesCleartextTraffic="true">
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <activity
            android:name=".NativeTvActivity"
            android:banner="@drawable/tiktak_tv_banner"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@drawable/tiktak_tv_icon"
            android:logo="@drawable/tiktak_tv_icon"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Nuvio.Splash" />

        <!--
          Keep the Fire TV launcher identity separate from the activity that
          hosts Compose. Fire OS caches Leanback artwork by component name and
          can retain a blank tile forever after an older build lacked complete
          badging. This alias gives upgraded installs a fresh, explicitly
          badged launcher component without changing the package or app data.
        -->
        <activity
            android:name=".TikTakTvLauncherV2Activity"
            android:banner="@drawable/tiktak_tv_banner"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:icon="@drawable/tiktak_tv_icon"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:logo="@drawable/tiktak_tv_icon"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Nuvio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NativeTvShellPreviewActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Nuvio.Splash" />

        <receiver
            android:name="com.nuvio.app.features.downloads.DownloadsNotificationActionReceiver"
            android:exported="false" />

        <service
            android:name="com.nuvio.app.features.downloads.DownloadsForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
