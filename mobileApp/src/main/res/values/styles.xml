<resources>
    <style name="Theme.TikTakTV" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/tiktak_background</item>
        <item name="android:colorAccent">@color/tiktak_accent</item>
        <item name="android:navigationBarColor">@color/tiktak_background</item>
        <item name="android:statusBarColor">@color/tiktak_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.TikTakTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tiktak_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TikTakTV</item>
    </style>
</resources>
